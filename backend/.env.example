# ---------------------------------------------------------------------------
# Estate Ease — BACKEND (Express API) environment template
# Copy to `backend/.env` (gitignored). These ARE secrets — never commit real
# values. In Phase 0/1 the server runs without Firebase (MOCK_MODE=true).
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated origins allowed to call the API (Expo dev + web)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Run without a live Firebase project. When true, Admin SDK init is skipped and
# routes operate against in-memory fixtures so the API boots with no credentials.
MOCK_MODE=true

# Firebase Admin SDK service account (Phase 2+). Provide EITHER the inline JSON
# (single line) OR a path to the key file. Leave blank while MOCK_MODE=true.
# NEVER commit the real key — it grants full backend access to your project.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Trust module tunables (business rules — see technical docs §3.3)
FRESH_THRESHOLD_DAYS=7
AGING_THRESHOLD_DAYS=14
UNAVAILABLE_REPORT_THRESHOLD=3

# True-cost estimate: months over which a refundable deposit is amortized
DEPOSIT_AMORTIZATION_MONTHS=12
