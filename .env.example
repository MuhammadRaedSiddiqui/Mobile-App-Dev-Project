# ---------------------------------------------------------------------------
# Estate Ease — MOBILE (Expo client) environment template
# Copy to `.env` (gitignored) and fill in. NO SECRETS beyond the public
# Firebase Web config, which is safe to ship in a client app.
#
# Values here are surfaced to the app via app.json `extra` / app.config.
# In Phase 0/1 the app runs on mock data (EXPO_PUBLIC_USE_MOCK=true), so
# real Firebase values are optional until Phase 2.
# ---------------------------------------------------------------------------

# Express API base URL (all WRITES go through this — never write to Firestore from the client)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Serve screens from bundled mock data instead of live services (Phase 0/1 = true)
EXPO_PUBLIC_USE_MOCK=true

# Firebase Web (client) config — public by design; used for client READS only.
# Leave blank while EXPO_PUBLIC_USE_MOCK=true.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
